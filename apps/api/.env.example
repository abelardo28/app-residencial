# Copia este archivo como .env (no se sube a git). En producción usa variables del entorno.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TZ=America/Mexico_City

DATABASE_PATH=./data/residencial.db
# Carga los datos de ejemplo si la base está vacía (sólo desarrollo; prohibido en producción)
SEED_DEMO=true

# URL pública de la APP (enlaces de activación y CORS). Orígenes extra separados por coma.
APP_URL=http://localhost:5173
CORS_ORIGINS=
# Detrás de un proxy (nginx, balanceador) para leer la IP real del cliente
TRUST_PROXY=false
AUTH_RATE_LIMIT=20

# Firma de los QR de acceso. Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_SECRET=

# Mensajería: console = buzón de desarrollo; live = Resend (correo) + WhatsApp Cloud API
MESSAGING_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Residencial <no-reply@tu-dominio.mx>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTH_TEMPLATE=codigo_verificacion
WHATSAPP_TEMPLATE_LANG=es_MX
# Asistente de WhatsApp: en Meta registra el webhook https://TU-API/api/v1/webhooks/whatsapp con este token
WHATSAPP_VERIFY_TOKEN=
# "Clave secreta de la app" de Meta: valida la firma X-Hub-Signature-256 de cada mensaje recibido
WHATSAPP_APP_SECRET=
# Plantillas aprobadas para avisos y recordatorios (variables en el orden que se indica en el README)
WHATSAPP_NOTICE_TEMPLATE=aviso_residencial
WHATSAPP_REMINDER_TEMPLATE=recordatorio_pago

# Ecart Pay: mock = cobros simulados; live = cuenta real (llaves sólo en el servidor)
ECARTPAY_MODE=mock
ECARTPAY_API_URL=https://sandbox.ecartpay.com/api
ECARTPAY_PUBLIC_KEY=
ECARTPAY_PRIVATE_KEY=
ECARTPAY_WEBHOOK_SECRET=
