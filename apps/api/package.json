{
  "name": "@residencial/api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del residencial: autenticación, cuentas, operaciones por rol y portal de empresa.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/cli.js seed",
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@residencial/shared": "*",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.2"
  }
}
