# Agente de caseta. Copia este archivo como .env y pega los tokens que genera la APP en Caseta física → Equipos.
API_URL=https://api.tu-residencial.mx

# ---------- Pluma ----------
BARRIER_TOKEN=
# console (sólo muestra en pantalla) · shelly (relevador Shelly) · http (cualquier controlador con URL)
RELAY=console
# shelly: IP del relevador · http: URL completa que activa el relevador (GET)
RELAY_URL=http://192.168.1.50
# Cuánto tiempo se mantiene cerrado el contacto (milisegundos)
RELAY_PULSE_MS=1000

# ---------- Lector de tags (tipo teclado USB o Wiegand con convertidor a USB) ----------
READER_TOKEN=
# stdin: el lector "escribe" el número del tag y un Enter en esta terminal
TAG_INPUT=stdin

# ---------- Cámara de placas (LPR) ----------
CAMERA_TOKEN=
# Puerto local donde la cámara envía sus avisos HTTP (Hikvision ANPR, Dahua o JSON {"plate":"ABC123A"})
LPR_PORT=8090
# Si lo defines, la cámara debe enviarlo en ?key= o en el encabezado X-Agent-Key
LPR_KEY=
