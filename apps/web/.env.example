# Origen de los datos: `api` (servidor en apps/api) o `demo` (simulación en el navegador)
VITE_DATA_MODE=api
# URL pública de la API si está en otro dominio. Vacío = mismo dominio (/api), recomendado.
VITE_API_URL=
# Llave pública VAPID para Web Push
VITE_VAPID_PUBLIC_KEY=
# Sólo desarrollo: a dónde reenvía Vite las peticiones /api
API_PROXY_TARGET=http://localhost:3000
