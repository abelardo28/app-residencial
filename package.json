{
  "name": "app-residencial",
  "private": true,
  "description": "Plataforma para residenciales: API (Fastify) + APP (React) + reglas de negocio compartidas.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @residencial/api\" \"npm run dev -w @residencial/web\"",
    "dev:demo": "npm run dev:demo -w @residencial/web",
    "build": "npm run build -w @residencial/web",
    "build:demo": "npm run build:demo -w @residencial/web",
    "start": "npm run start -w @residencial/api",
    "db:migrate": "npm run db:migrate -w @residencial/api",
    "db:seed": "npm run db:seed -w @residencial/api",
    "test": "npm test --workspaces --if-present",
    "lint": "oxlint apps/api/src apps/web/src packages/shared/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2"
  }
}
